[
{
"t0": 0.18,
"t1": 1.55,
"text": "On t’offre un bonheur parfait."
},
{
"t0": 2.23,
"t1": 2.92,
"text": "Une seule condition :"
},
{
"t0": 3.29,
"t1": 3.81,
"text": "rien n’est vrai."
},
{
"t0": 4.79,
"t1": 5.14,
"text": "Tu appuies ?"
},
{
"t0": 5.92,
"t1": 6.24,
"text": "Choisis."
},
{
"t0": 6.96,
"t1": 7.31,
"text": "Maintenant."
},
{
"t0": 8.14,
"t1": 9.0,
"text": "Et retiens ta réponse."
},
{
"t0": 9.47,
"t1": 10.9,
"text": "Parce que dans deux minutes, tu risques d’en changer."
},
{
"t0": 11.94,
"t1": 12.83,
"text": "Imagine une machine."
},
{
"t0": 13.75,
"t1": 15.37,
"text": "Tu t’allonges. On te branche quelques fils."
},
{
"t0": 15.71,
"t1": 16.92,
"text": "Et tu vis la vie dont tu rêves."
},
{
"t0": 17.5,
"t1": 18.23,
"text": "Le grand amour."
},
{
"t0": 18.55,
"t1": 19.94,
"text": "Le livre qui bouleverse le monde."
},
{
"t0": 20.29,
"t1": 21.83,
"text": "La foule qui se lève pour t’applaudir."
},
{
"t0": 22.59,
"t1": 23.62,
"text": "Sauf que ton corps, lui,"
},
{
"t0": 24.11,
"t1": 24.8,
"text": "flotte dans une cuve."
},
{
"t0": 25.63,
"t1": 26.32,
"text": "Et voici le piège."
},
{
"t0": 26.84,
"t1": 27.31,
"text": "Une fois dedans,"
},
{
"t0": 27.7,
"t1": 28.33,
"text": "tu oublies la machine."
},
{
"t0": 28.82,
"t1": 30.05,
"text": "Pour toi, tout est réel."
},
{
"t0": 31.05,
"t1": 33.98,
"text": "Un philosophe pose cette question en 1974."
},
{
"t0": 34.88,
"t1": 35.55,
"text": "Robert Nozick."
},
{
"t0": 36.03,
"t1": 37.25,
"text": "Et il pense que tu vas refuser."
},
{
"t0": 37.78,
"t1": 39.02,
"text": "Car si seul le plaisir comptait,"
},
{
"t0": 39.27,
"t1": 39.87,
"text": "tu foncerais, non ?"
},
{
"t0": 40.55,
"t1": 41.73,
"text": "Alors… pourquoi tu hésites ?"
},
{
"t0": 42.56,
"t1": 43.4,
"text": "Nozick voit trois raisons."
},
{
"t0": 43.97,
"t1": 44.12,
"text": "Un."
},
{
"t0": 44.57,
"t1": 46.59,
"text": "Tu ne veux pas juste croire que tu as sauvé ton ami."
},
{
"t0": 47.11,
"t1": 47.98,
"text": "Tu veux l’avoir sauvé."
},
{
"t0": 48.73,
"t1": 48.93,
"text": "Deux."
},
{
"t0": 49.56,
"t1": 50.23,
"text": "Tu veux être quelqu’un."
},
{
"t0": 50.86,
"t1": 51.99,
"text": "Mais ce corps dans la cuve,"
},
{
"t0": 52.39,
"t1": 53.37,
"text": "il est courageux ?"
},
{
"t0": 53.55,
"t1": 54.45,
"text": "Drôle ? Aimant ?"
},
{
"t0": 55.17,
"t1": 56.6,
"text": "Pour Nozick, il n’est rien de tout ça."
},
{
"t0": 57.15,
"t1": 58.13,
"text": "C’est une masse sans forme."
},
{
"t0": 59.08,
"t1": 59.29,
"text": "Trois."
},
{
"t0": 59.89,
"t1": 61.3,
"text": "Tu veux toucher une réalité plus vaste"
},
{
"t0": 61.3,
"t1": 62.78,
"text": "que ce que des humains ont fabriqué."
},
{
"t0": 63.73,
"t1": 65.16,
"text": "Et l’expérience semble lui donner raison."
},
{
"t0": 65.79,
"t1": 67.15,
"text": "On a posé la question à des étudiants."
},
{
"t0": 67.83,
"t1": 69.69,
"text": "84 % ont refusé."
},
{
"t0": 70.48,
"t1": 70.93,
"text": "Affaire classée ?"
},
{
"t0": 71.69,
"t1": 72.56,
"text": "Sauf qu’en 2010,"
},
{
"t0": 72.66,
"t1": 74.24,
"text": "un autre philosophe retourne la question."
},
{
"t0": 75.15,
"t1": 76.05,
"text": "Felipe De Brigard."
},
{
"t0": 76.64,
"t1": 77.04,
"text": "Imagine."
},
{
"t0": 77.48,
"t1": 78.27,
"text": "On frappe à ta porte."
},
{
"t0": 78.82,
"t1": 79.58,
"text": "Un inconnu te dit :"
},
{
"t0": 80.08,
"t1": 81.92,
"text": "« Désolé. Il y a eu une erreur. »"
},
{
"t0": 82.3,
"t1": 83.8,
"text": "« Ta famille, tes amis, tes souvenirs…"
},
{
"t0": 84.43,
"t1": 85.54,
"text": "Tu es déjà dans la machine. »"
},
{
"t0": 85.98,
"t1": 86.74,
"text": "« On peut te débrancher."
},
{
"t0": 87.29,
"t1": 88.61,
"text": "Mais alors, tu perds tout ça. »"
},
{
"t0": 89.26,
"t1": 89.6,
"text": "Tu fais quoi ?"
},
{
"t0": 90.55,
"t1": 91.9,
"text": "Cette fois, presque la moitié"
},
{
"t0": 91.9,
"t1": 93.41,
"text": "des étudiants interrogés veulent rester."
},
{
"t0": 93.95,
"t1": 95.14,
"text": "On leur annonce qu’en vrai,"
},
{
"t0": 95.41,
"t1": 96.75,
"text": "ils sont riches, à Monaco ?"
},
{
"t0": 97.46,
"t1": 98.39,
"text": "Une moitié reste quand même."
},
{
"t0": 99.0,
"t1": 100.71,
"text": "Et si la vraie vie les attend en prison ?"
},
{
"t0": 101.39,
"t1": 102.66,
"text": "Près de neuf sur dix restent."
},
{
"t0": 103.68,
"t1": 104.57,
"text": "Tu comprends ce que ça veut dire ?"
},
{
"t0": 105.58,
"t1": 107.01,
"text": "Ce n’est peut-être pas la vérité qu’on aime."
},
{
"t0": 107.61,
"t1": 108.48,
"text": "C’est peut-être juste…"
},
{
"t0": 108.82,
"t1": 109.48,
"text": "ce qu’on connaît déjà."
},
{
"t0": 110.15,
"t1": 110.65,
"text": "Ça porte un nom :"
},
{
"t0": 111.06,
"t1": 112.05,
"text": "le biais du statu quo."
},
{
"t0": 112.75,
"t1": 114.49,
"text": "Et maintenant, regarde ce que tu tiens dans la main."
},
{
"t0": 115.1,
"t1": 115.78,
"text": "Une petite machine."
},
{
"t0": 116.49,
"t1": 117.62,
"text": "Pleine de vies qui ne sont pas la tienne."
},
{
"t0": 118.38,
"t1": 119.39,
"text": "Tu n’as pas tout débranché."
},
{
"t0": 119.63,
"t1": 120.12,
"text": "Mais le bouton…"
},
{
"t0": 120.42,
"t1": 121.2,
"text": "tu l’as déjà effleuré."
},
{
"t0": 122.22,
"t1": 123.36,
"text": "Alors je te repose la question."
},
{
"t0": 123.9,
"t1": 124.3,
"text": "Ce soir,"
},
{
"t0": 124.4,
"t1": 126.3,
"text": "tu apprends que toute ta vie est la machine."
},
{
"t0": 127.17,
"t1": 128.27,
"text": "Tu sors, ou tu restes ?"
},
{
"t0": 129.07,
"t1": 129.92,
"text": "Écris un seul mot :"
},
{
"t0": 130.57,
"t1": 131.71,
"text": "« sors »… ou « reste »."
},
{
"t0": 132.32,
"t1": 133.08,
"text": "Et une seule raison."
},
{
"t0": 133.95,
"t1": 134.53,
"text": "Réfléchis bien."
},
{
"t0": 135.26,
"t1": 137.02,
"text": "Un jour, quelqu’un viendra peut-être te dire :"
}
]